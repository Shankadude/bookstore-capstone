pipeline {
    agent any
    tools {
        maven 'Maven-3.9.9'
        jdk 'JDK-17'
    }
    stages {
        stage('Checkout') { steps { checkout scm } }
        stage('API Tests') {
            steps {
                dir('api_testing') {
                    bat 'pytest tests/ -v --junitxml=reports/api-results.xml'
                }
            }
        }
        stage('UI Tests') {
            steps {
                dir('ui_automation') {
                    bat 'mvn clean test'
                }
            }
        }
    }
}
