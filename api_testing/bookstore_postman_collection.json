{
  "info": {
    "name": "Bookstore_API_Capstone_Collection",
    "description": "Full-Stack QA Capstone Postman Collection with status, header, SLA, and schema assertions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Get All Books Catalog",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Content-Type header is application/json', function () {",
              "    pm.response.to.have.header('Content-Type');",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "pm.test('Catalog contains valid books list', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.books).to.be.an('array').that.is.not.empty;",
              "    pm.expect(jsonData.books[0]).to.have.all.keys('isbn', 'title', 'subTitle', 'author', 'publish_date', 'publisher', 'pages', 'description', 'website');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://demoqa.com/BookStore/v1/Books",
          "protocol": "https",
          "host": ["demoqa", "com"],
          "path": ["BookStore", "v1", "Books"]
        }
      }
    },
    {
      "name": "2. Get Single Book Details by ISBN",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Book details match Git Pocket Guide', function () {",
              "    const book = pm.response.json();",
              "    pm.expect(book.isbn).to.eql('9781449325862');",
              "    pm.expect(book.title).to.eql('Git Pocket Guide');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://demoqa.com/BookStore/v1/Book?ISBN=9781449325862",
          "protocol": "https",
          "host": ["demoqa", "com"],
          "path": ["BookStore", "v1", "Book"],
          "query": [{"key": "ISBN", "value": "9781449325862"}]
        }
      }
    },
    {
      "name": "3. Negative Test - Invalid ISBN Returns 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 400 Bad Request', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test('Error payload contains code and message', function () {",
              "    const err = pm.response.json();",
              "    pm.expect(err).to.have.property('code');",
              "    pm.expect(err).to.have.property('message');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://demoqa.com/BookStore/v1/Book?ISBN=0000000000",
          "protocol": "https",
          "host": ["demoqa", "com"],
          "path": ["BookStore", "v1", "Book"],
          "query": [{"key": "ISBN", "value": "0000000000"}]
        }
      }
    }
  ]
}
